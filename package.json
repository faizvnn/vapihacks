{
  "name": "jamie-fact-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --import ./server/load-env.mjs --import tsx server/src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --import ./server/load-env.mjs dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/test/*.test.ts",
    "fixtures": "node --import ./server/load-env.mjs --import tsx server/scripts/run-fixtures.ts",
    "spike": "node --import ./server/load-env.mjs --import tsx server/scripts/spike.ts",
    "smoke": "node --import ./server/load-env.mjs --import tsx server/scripts/smoke.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "fastify": "5.12.8",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
