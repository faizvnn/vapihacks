{
  "name": "jamie-fact-checker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test server/test/*.test.ts",
    "fixtures": "node --env-file-if-exists=.env --import tsx server/scripts/run-fixtures.ts",
    "spike": "node --env-file-if-exists=.env --import tsx server/scripts/spike.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0",
    "fastify": "5.12.8",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
